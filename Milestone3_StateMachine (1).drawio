<mxfile host="app.diagrams.net">
  <diagram name="State Machine">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="off" value="Off" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="dot" value="Dot" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="60" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="dash" value="Dash" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="60" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ddp" value="Dot/Dash Pause" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="lp" value="Letter Pause" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="wp" value="Word Pause" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="140" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="Button Press&#10;toggleMessage()&#10;SOS ↔ OK" style="shape=note;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="220" width="180" height="80" as="geometry"/>
        </mxCell>

<mxCell id="e0" edge="1" parent="1" source="off" target="dot">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e1" edge="1" parent="1" source="dot" target="off">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e2" edge="1" parent="1" source="off" target="dash">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e3" edge="1" parent="1" source="dash" target="off">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e4" edge="1" parent="1" source="off" target="ddp">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e5" edge="1" parent="1" source="ddp" target="off">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e6" edge="1" parent="1" source="off" target="lp">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e7" edge="1" parent="1" source="lp" target="off">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e8" edge="1" parent="1" source="off" target="wp">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>
<mxCell id="e9" edge="1" parent="1" source="wp" target="off">
    <mxGeometry relative="1" as="geometry"/>
</mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
